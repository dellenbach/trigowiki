# .env.example
#
# Vorlage fuer die .env-Datei im PROD_ROOT-Verzeichnis.
# Kopieren: cp .env.example .env
# Dann echte Werte eintragen. .env ist gitignored.
#
# Genutzt von: docker-compose.yml und script/start-wiki-production.sh
# Ablage auf Server: /srv/mediawiki-production/.env

# MySQL root-Passwort des mediawiki_mysql_production-Containers
MEDIAWIKI_DB_PASSWORD=change-me

# MediaWiki Secret Key (mind. 64 zufaellige Hex-Zeichen)
# Erzeugen: python3 -c "import secrets; print(secrets.token_hex(64))"
MEDIAWIKI_SECRET_KEY=change-me

# Vollstaendige URL des Wikis (z.B. http://trigowiki.trigonet.local oder https://wiki.example.com)
MEDIAWIKI_SERVER=http://trigowiki.trigonet.local

# Basis-Verzeichnis auf dem Host (nur fuer docker-compose.yml noetig, wenn von .env aus gesetzt)
PROD_ROOT=/srv/mediawiki-production

# Optional: Absenderadressen fuer Wiki-E-Mails
MEDIAWIKI_EMERGENCY_CONTACT=wiki@example.com
MEDIAWIKI_PASSWORD_SENDER=wiki@example.com

# Optional: SMTP fuer Mailversand (typisch: Port 587 mit Auth)
MEDIAWIKI_SMTP_HOST=smtp.example.com
MEDIAWIKI_SMTP_PORT=587
MEDIAWIKI_SMTP_AUTH=1
MEDIAWIKI_SMTP_SECURE=tls
MEDIAWIKI_SMTP_USERNAME=wiki@example.com
MEDIAWIKI_SMTP_PASSWORD=change-me
