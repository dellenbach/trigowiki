worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include mime.types;
    server_tokens off;
    charset utf-8;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    upstream trigowiki_backend {
        server __WIKI_BACKEND__;
    }

    upstream appsmith_backend {
        server __APPSMITH_BACKEND__;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    proxy_read_timeout 300;
    proxy_send_timeout 300;
    proxy_connect_timeout 30;
    client_max_body_size 500M;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    server {
        listen 80;
        listen [::]:80;
        server_name trigowiki.trigonet.local _;

        location = /app {
            proxy_pass http://appsmith_backend/app;
            proxy_http_version 1.1;
        }

        location ^~ /app/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /applications {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /user/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /api/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /v1/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /oauth2/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /login/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /logout/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /signup/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /static/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /assets/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /scripts/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /health-check/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location = /favicon.ico {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
        }

        location ^~ /socket.io/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location ^~ /ws {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location / {
            proxy_pass http://trigowiki_backend;
            proxy_http_version 1.1;
            proxy_redirect off;
        }
    }

    server {
        listen 80;
        listen [::]:80;
        server_name appsmith.trigonet.local;

        location ^~ /socket.io/ {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location ^~ /ws {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location / {
            proxy_pass http://appsmith_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_redirect off;
        }
    }
}